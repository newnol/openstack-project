% Paragraph Spacing, Indentation, and Overflow Protection
\setlength{\parskip}{5pt}
\setlength{\parindent}{0.6cm}
\emergencystretch 3em
\hfuzz=1pt
\vfuzz=1pt

% Line spacing 1.2
